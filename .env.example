# 校园讲座自动预约 · 环境变量
# 用法：复制为 .env 后填写。程序自动读取本文件；进程环境变量优先于文件。
# 一般不需要加引号。只有下面两种情况才用引号包住整个值：
#   1) 值首尾带空格（尤其密码）——冒号后直接写、行尾空格会被吞掉
#   2) 值本身以引号开头或结尾
# 包法：内容不含单引号就用单引号 '...'（原样保留）；含单引号就用双引号 "..."。
# 切勿提交真实 .env 到仓库。

# ── 一、接入地址（必填）──────────────────────────────────────
# 讲座预约微应用的入口地址。浏览器登录后打开讲座预约页，地址栏里形如：
#   https://<域名>/gsapp/sys/<应用名>/*default/index.do
# 未登录时访问该地址会被跳转到统一认证页面
LEC_ENTRY_URL=

# 统一认证（CAS）接口前缀，一般以 /auth/casback/ 结尾
LEC_CAS_BASE=

# 可选：统一认证网关。部分学校的会话经网关签发，留空则直接走 CAS
LEC_GATEWAY=

# 可选：网关域名的备用 IP。域名在某些网络下解析不到时填写，
# 请求仍带原域名做 Host 与 TLS 校验，不降低安全性
LEC_GATEWAY_IP=

# 可选：额外的业务接口基址，逗号分隔。留空则只从 LEC_ENTRY_URL 推导
LEC_API_BASES=

# ── 二、登录（必填）──────────────────────────────────────────
# 统一身份认证的账号与密码，程序用 CAS 登录，不再需要手动复制 Cookie
LEC_USERNAME=
LEC_PASSWORD=

# ── 三、目标筛选 ─────────────────────────────────────────────
# 标题关键词，JSON 数组；任一命中即为目标。留空 [] 表示不按关键词过滤
# 例：'["法律","心理健康"]'
LEC_TARGET_KEYWORDS='[]'

# 讲座分类，JSON 数组，留空 [] 不限。例：'["某系列讲座"]'
LEC_REQUIRED_CATEGORIES='[]'

# 校区，JSON 数组，留空 [] 不限。例：'["某校区"]'
LEC_PREFERRED_CAMPUS='[]'

# 线上线下开关；两者都开则全部预约
LEC_ENABLE_ONLINE=true
LEC_ENABLE_OFFLINE=true

# ── 四、抢位行为 ─────────────────────────────────────────────
# 候补阶段的列表刷新间隔（秒）。系统压力大或频繁 503 时调大到 0.5~1
LEC_POLL_SECONDS=0.2
# 开放瞬间的快速连击次数
LEC_BURST_ATTEMPTS=5
# 保活请求间隔（秒），保持登录会话不超时
LEC_KEEPALIVE_SECONDS=30
# 开放前多少秒预取验证码
LEC_PREFETCH_SECONDS=2
# 最多提交多少次后放弃，0 表示不限（一直等到截止）
LEC_MAX_ATTEMPTS=0
# 状态与日志目录
LEC_STATE_DIR=state

# 是否让请求跟随系统代理。默认 false（直连）；
# 如果你开着 Clash/V2Ray 等代理且直连不通，改成 true 试试
LEC_USE_PROXY=false

# ── 五、邮件通知（可选）──────────────────────────────────────
# 全部留空则不发送邮件，事件仍写入终端和日志。
# 填「SMTP 授权码」/「应用专用密码」，不是邮箱登录密码，都不需要加引号。
# 常见邮箱开启 SMTP 后生成授权码；Gmail 用应用专用密码，带空格粘贴也能识别
SMTP_USERNAME=
SMTP_PASSWORD=
# 一般留空，按发信邮箱域名自动推断；特殊服务商才需要手动指定
# SMTP_HOST=smtp.qq.com
# SMTP_PORT=465
# MAIL_FROM=
# MAIL_TO=
# 每天北京时间几点汇报一次进度，留空或 0 关闭
LEC_MAIL_REPORT_HOUR=20
