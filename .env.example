# 东南大学讲座自动预约 · 环境变量
# 用法：复制为 .env 后填写。程序自动读取本文件；进程环境变量优先于文件。
# 一般不需要加引号。只有下面两种情况才用引号包住整个值：
#   1) 值首尾带空格（尤其密码）——冒号后直接写、行尾空格会被吞掉
#   2) 值本身以引号开头或结尾
# 包法：内容不含单引号就用单引号 '...'（原样保留）；含单引号就用双引号 "..."。
# 切勿提交真实 .env 到仓库：账号、密码、状态文件都只留在本机。

# ── 一、登录（必填）──────────────────────────────────────────
# 统一身份认证的一卡通号与密码，程序用 CAS 登录，不再需要手动复制 Cookie
SEU_USERNAME=
SEU_PASSWORD=

# 短信二次认证（可选）。账号触发 CAS 二次验证时，程序会发短信并在终端提示输入。
# 若要在无交互环境运行，可把收到的验证码预置到这里；验证码一次性，用完请清空。
SEU_STAGE2_CODE=
# 设备指纹（可选）。留空则不请求「记住此设备」，每次登录都会要短信验证码。
# 想启用设备信任，填一个固定的随机串（如 `openssl rand -hex 16` 的输出）；
# 首次短信验证通过后服务端可能记住该设备，后续登录免验证码。
# 这个值相当于信任凭证，不要公开；想复用浏览器已信任的设备时，
# 可从浏览器登录请求的 fingerPrint 字段复制过来。
SEU_FINGERPRINT=

# ── 一·补、多账号（可选）────────────────────────────────────
# 需要一次帮几个账号抢时填这里。JSON 数组，每项 username / password。
# 填了这项就忽略上面的 SEU_USERNAME / SEU_PASSWORD；
# 其余配置（关键词、分类、校区、节奏）由所有账号共享。
# 每个账号自动使用 state/<哈希>/ 独立状态目录，记录不会互相覆盖。
# 警告：同一 IP 多账号并发容易触发学校风控，建议只抢刚需、或错开时段。
# SEU_ACCOUNTS='[{"username":"101012345","password":"pass1"},{"username":"202056789","password":"pass2"}]'

# ── 二、接入地址（已按东大填好，一般不用改）──────────────────
# 讲座预约微应用入口
SEU_ENTRY_URL=https://ehall.seu.edu.cn/gsapp/sys/yddjzxxtjappseu/*default/index.do
# 统一认证（CAS）接口前缀
SEU_CAS_BASE=https://auth.seu.edu.cn/auth/casback/
# 统一认证网关：东大会话经网关签发
SEU_GATEWAY=https://vpn.seu.edu.cn
# 网关备用 IP：vpn.seu.edu.cn 在公共 DNS 下解析不到，用 IP 直连（证书仍按域名校验）
SEU_GATEWAY_IP=121.249.14.2
# 额外候选接口基址：讲座业务实际在新版应用上，程序会依次探测
SEU_API_BASES=https://ehall.seu.edu.cn/gsapp/sys/jzxxtjapp

# ── 三、目标筛选 ─────────────────────────────────────────────
# 标题关键词，JSON 数组；任一命中即为目标。留空 [] 表示不按关键词过滤
# 例：'["法律","心理健康"]'
SEU_TARGET_KEYWORDS='[]'

# 讲座分类，JSON 数组，留空 [] 不限
# 例：'["人文与科学素养系列讲座_法律"]'
SEU_REQUIRED_CATEGORIES='[]'

# 校区，JSON 数组，留空 [] 不限。
# 只约束线下讲座——线上讲座在哪都能听，不受校区限制。
# 例：'["九龙湖校区"]'，写 '["九龙湖"]' 也行（子串匹配）
SEU_PREFERRED_CAMPUS='[]'

# 线上线下开关；两者都开则全部预约
SEU_ENABLE_ONLINE=true
SEU_ENABLE_OFFLINE=true

# ── 四、抢位行为 ─────────────────────────────────────────────
# 候补阶段的列表刷新间隔（秒）。系统压力大或频繁 503 时调大到 0.5~1
SEU_POLL_SECONDS=0.2
# 开放瞬间的快速连击次数
SEU_BURST_ATTEMPTS=5
# 服务器返回「繁忙」时的重试间隔（秒），逗号分隔，用完后保持最后一档。
# 学校按账号限流，等太短等于白撞；默认从 0.5 秒逐步退到 8 秒
SEU_BUSY_DELAYS=0.5,1,2,4,8
# 在上述间隔上叠加的随机抖动上限（秒），避免几个讲座同时重试撞在一起
SEU_BUSY_JITTER=0.5
# 满员后复查余量的间隔（秒）。越小越容易捡到别人退的名额，
# 但对服务器请求也越多；限流明显时调到 15~30
SEU_FULL_WATCH=8
# 保活请求间隔（秒），保持登录会话不超时
SEU_KEEPALIVE_SECONDS=30
# 开放前多少秒预取验证码
SEU_PREFETCH_SECONDS=2
# 最多提交多少次后放弃，0 表示不限（一直等到截止）
SEU_MAX_ATTEMPTS=0
# 状态与日志目录
SEU_STATE_DIR=state

# 是否让请求跟随系统代理。默认 false（直连校园系统）；
# 如果你开着 Clash/V2Ray 等代理且直连不通，改成 true 试试
SEU_USE_PROXY=false

# ── 五、邮件通知（可选）──────────────────────────────────────
# 全部留空则不发送邮件，事件仍写入终端和日志。
# 填「SMTP 授权码」/「应用专用密码」，不是邮箱登录密码，都不需要加引号。
# QQ/163/126：邮箱设置里开启 SMTP 后生成的授权码
# Gmail：应用专用密码；带空格粘贴成「abcd efgh ijkl mnop」也能识别，程序会自动去掉
SMTP_USERNAME=
SMTP_PASSWORD=
# 一般留空，按发信邮箱域名自动推断；特殊服务商才需要手动指定
# SMTP_HOST=smtp.qq.com
# SMTP_PORT=465
# MAIL_FROM=
# MAIL_TO=
# 每天北京时间几点汇报一次进度，留空或 0 关闭
SEU_MAIL_REPORT_HOUR=20
